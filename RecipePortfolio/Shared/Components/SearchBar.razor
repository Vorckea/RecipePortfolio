@using RecipePortfolio.Utils
@implements IDisposable


<div class="position-relative">
    <label class="sr-only" for="@inputId">Search</label>
    <input type="text"
        class="form-control search-bar"
        value="@SearchTerm"
        @oninput="OnInput"
        @onkeydown="OnKeyDown"
        @onfocusout="OnFocusOut"
        placeholder="@Placeholder"
        role="combobox"
        aria-expanded="@(ShowSuggestions ? "true":"false")"
        aria-controls="@suggestionsListId"
        aria-autocomplete="list"
        />

    @if (ShowSuggestions && Suggestions?.Any() == true)
    {
        <ul id="@suggestionsListId" class="dropdown-menu d-block w-100 border-top-0 rounded-0 rounded-bottom shadow-sm" role="listbox">
            @foreach (var (suggestion, index) in Suggestions.Select((s, i) => (s, i)))
            {
                var optionId = $"{suggestionItemIdPrefix}-{index}";

                <li
                    id="@optionId"
                    role="option"
                    class="dropdown-item @(SelectedIndex == index ? "active" : "")"
                    aria-selected="@(SelectedIndex == index)"
                    @onmousedown:preventDefault
                    @onclick="() => SelectSuggestion(suggestion)">
                    @suggestion
                </li>
            }
        </ul>
    }
</div>



@code {
    private CancellationTokenSource? inputDebounceCts;
    private CancellationTokenSource? providerDebounceCts;
    private CancellationTokenSource? providerCts;
    private bool ShowSuggestions = false;
    private int SelectedIndex = -1;
    private IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();

    private readonly string inputId = $"search-input-{Guid.NewGuid():N}";
    private readonly string suggestionsListId = $"search-suggestions-{Guid.NewGuid():N}";
    private readonly string suggestionItemIdPrefix = $"search-suggestion-{Guid.NewGuid():N}";

    private string? ActiveDescendentId => SelectedIndex >= 0 ? $"{suggestionItemIdPrefix}-{SelectedIndex}" : null;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTermChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Search...";

    [Parameter]
    public Func<string, CancellationToken, Task<List<string>>>? SuggestionProvider { get; set; }

    [Parameter]
    public int MinimumSearchLength { get; set; } = 2;

    private async Task OnInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        SearchTerm = value;

        DebounceUtils.Debounce(async () => await SearchTermChanged.InvokeAsync(SearchTerm), ref inputDebounceCts);

        if (SuggestionProvider != null && value.Length >= MinimumSearchLength)
        {
            DebounceUtils.Debounce(async () =>
            {
                providerCts?.Cancel();
                providerCts?.Dispose();
                providerCts = new CancellationTokenSource();
                try
                {
                    var suggestions = await SuggestionProvider(value, providerCts.Token);
                    await InvokeAsync(() =>
                    {
                        Suggestions = (suggestions ?? new List<string>()).ToArray();
                        ShowSuggestions = Suggestions.Any();
                        SelectedIndex = -1;
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) {}
                catch (Exception)
                {
                    await InvokeAsync(() =>
                    {
                        Suggestions = Array.Empty<string>();
                        ShowSuggestions = false;
                        StateHasChanged();
                    });
                }
            }, ref providerDebounceCts);
        }
        else
        {
            Suggestions = Array.Empty<string>();
            ShowSuggestions = false;
            SelectedIndex = -1;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!ShowSuggestions || Suggestions == null || !Suggestions.Any()) return;

        switch (e.Key)
        {
            case "ArrowDown":
                SelectedIndex = Math.Min(SelectedIndex + 1, Suggestions.Count - 1);
                StateHasChanged();
                break;
            case "ArrowUp":
                SelectedIndex = Math.Max(SelectedIndex - 1, -1);
                StateHasChanged();
                break;
            case "Home":
                SelectedIndex = 0;
                await InvokeAsync(StateHasChanged);
                break;
            case "End":
                SelectedIndex = Suggestions.Count - 1;
                await InvokeAsync(StateHasChanged);
                break;
            case "Enter":
                if (SelectedIndex >= 0 && SelectedIndex < Suggestions.Count)
                {
                    await SelectSuggestion(Suggestions[SelectedIndex]);
                }
                break;
            case "Escape":
                ShowSuggestions = false;
                StateHasChanged();
                break;
        }
    }

    private async Task OnFocusOut()
    {
        await Task.Delay(150);
        ShowSuggestions = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectSuggestion(string suggestion)
    {
        SearchTerm = suggestion;
        ShowSuggestions = false;
        SelectedIndex = -1;
        await SearchTermChanged.InvokeAsync(SearchTerm);
    }

    public void Dispose()
    {
        try { inputDebounceCts?.Cancel(); inputDebounceCts?.Dispose(); inputDebounceCts = null; } catch { }
        try { providerDebounceCts?.Cancel(); providerDebounceCts?.Dispose(); providerDebounceCts = null; } catch { }
        try { providerCts?.Cancel(); providerCts?.Dispose(); providerCts = null; } catch { }
    }

}
